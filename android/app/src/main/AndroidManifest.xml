<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To follow the real network under the VPN (IPv6 or not). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- A VPN app may use the systemExempted type once the user has allowed
         the VPN (the ACTIVATE_VPN app op, which lint does not know about).
         It is the only type: the service is started only after that consent
         (ShroudlyVpnService.start), and Google Play needs no specialUse
         review for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- "Proxy only" (ShroudlyProxyService) runs with no VPN, so it is not a
         VPN app's service then: Android 14+ needs a type for it, and none of
         the listed ones fits a local proxy (dataSync would stop it after six
         hours a day on Android 15). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Start when the phone starts" (Settings, off by default). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Apps that skip Shroudly" lists the apps that can be opened (their
         launcher entries), not every package on the phone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- No backup and no device-to-device copy of anything: see
         res/xml/data_extraction_rules.xml (Android 12+); allowBackup covers
         the earlier versions. extractNativeLibs: the native libraries (the
         engine and hev) stay compressed in the APK, a smaller download, and
         are unpacked at install; bundletool keeps this in every APK Google
         Play makes from the bundle. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shroudly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShroudlyVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!-- Proxy only (Settings): the engine as a proxy on 127.0.0.1, no VPN. -->
        <service
            android:name=".ShroudlyProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A local proxy on 127.0.0.1 that other apps on this device send their connections through, chosen by the user instead of the VPN so that another VPN app can stay connected; it runs while the user keeps protection on and stops when they turn it off." />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/navSettings" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Renames the notification channels when the system language changes. -->
        <receiver
            android:name=".LocaleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ShroudlyTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
