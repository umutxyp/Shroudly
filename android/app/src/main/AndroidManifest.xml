<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV and Google TV: no touchscreen, a remote instead; the
         same app, with a banner in the TV's launcher. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To follow the real network under the VPN (IPv6 or not). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- A VPN app may use the systemExempted type once the user has allowed
         the VPN (the ACTIVATE_VPN app op, which lint does not know about).
         It is the only type: the service is started only after that consent
         (ShroudlyVpnService.start), and Google Play needs no specialUse
         review for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- "Proxy only" (ShroudlyProxyService) runs with no VPN, so it is not a
         VPN app's service then: Android 14+ needs a type for it, and none of
         the listed ones fits a local proxy (dataSync would stop it after six
         hours a day on Android 15). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Start when the phone starts" (Settings, off by default). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Apps that skip Shroudly" lists the apps that can be opened (their
         launcher entries), not every package on the phone; and whether the
         Play Store is there, for the suggestion to move to the copy from
         Google Play (StoreCards). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- On a TV, apps are opened from the TV's launcher. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.android.vending" />
    </queries>

    <!-- No backup and no device-to-device copy of anything: see
         res/xml/data_extraction_rules.xml (Android 12+); allowBackup covers
         the earlier versions. extractNativeLibs: the native libraries (the
         engine and hev) stay compressed in the APK, a smaller download, and
         are unpacked at install; bundletool keeps this in every APK Google
         Play makes from the bundle. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shroudly">

        <!-- "Share Shroudly": this app's APK, to the app the user picks,
             for that once (ApkShare). -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The main window (HomeActivity, all of it MainActivity's). The
             launcher's entries are aliases of it, one per logo (Logos.kt):
             the classic one keeps the name ".MainActivity" that launchers
             have pinned since the first version; the others are off until
             chosen in Settings. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- A long press on the Quick Settings tile opens Shroudly, not
                 Android's App info (issue #35). -->
            <intent-filter>
