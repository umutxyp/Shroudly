        <service
            android:name=".ShroudlyVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!-- Proxy only (Settings): the engine as a proxy on 127.0.0.1, no VPN. -->
        <service
            android:name=".ShroudlyProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A local proxy on 127.0.0.1 that other apps on this device send their connections through, chosen by the user instead of the VPN so that another VPN app can stay connected; it runs while the user keeps protection on and stops when they turn it off." />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/navSettings" />

        <!-- "Something not working?" (ReportActivity). -->
        <activity
            android:name=".ReportActivity"
            android:exported="false"
            android:label="@string/reportTitle"
            android:windowSoftInputMode="adjustResize" />

        <!-- Follow Shroudly (FollowActivity). -->
        <activity
            android:name=".FollowActivity"
            android:exported="false"
            android:label="@string/followTitle" />

        <!-- Connections by site, with blocking (issue #74; ConnectionsActivity). -->
        <activity
            android:name=".ConnectionsActivity"
            android:exported="false"
            android:label="@string/connsTitle" />

        <!-- Brings protection back once a network is there, if it ended
             without the user turning it off (KeepOn). -->
        <service
            android:name=".ResumeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- "Start when the phone starts" (Settings), and protection back on
             after an update of Shroudly ended it (KeepOn.updated). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Automation apps (Tasker, MacroDroid): on, off, switch. Every
             broadcast is ignored until the user allows it in Settings. -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="me.codeshare.shroudly.action.START" />
                <action android:name="me.codeshare.shroudly.action.STOP" />
                <action android:name="me.codeshare.shroudly.action.TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widget (ShroudlyWidget): its own taps only. -->
        <receiver
            android:name=".ShroudlyWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Renames the notification channels when the system language changes. -->
        <receiver
            android:name=".LocaleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ShroudlyTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_logo"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- An on/off switch (Android 13+). Not an "active" tile: the
                 panel asks it for its state each time it opens, which every
                 phone's panel does, while some never ask an active one and
                 show a state of their own (issue #49). -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
