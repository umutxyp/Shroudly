<?xml version="1.0" encoding="utf-8"?>
<!-- The round switch around the logo, as on the desktop and the iPhone: dark
     glass with a fine line when off; lit lightly in the accent once on. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/accentSoft">
    <item>
        <selector
            android:enterFadeDuration="350"
            android:exitFadeDuration="350">
            <item android:state_activated="true">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/surface"
                        android:startColor="?attr/accentSoft" />
                    <stroke android:width="1.5dp" android:color="?attr/accentLine" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/surface"
                        android:startColor="@color/surface_2" />
                    <stroke android:width="1.2dp" android:color="@color/line_strong" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
