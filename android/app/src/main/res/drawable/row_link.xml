<?xml version="1.0" encoding="utf-8"?>
<!-- A RowIcon as one drawable (the tile, lucide "link" in it), for a
     row that is one TextView or a switch's own start drawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="30dp"
        android:height="30dp"
        android:drawable="@drawable/icon_tile" />
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="center"
        android:drawable="@drawable/ic_link_accent" />
</layer-list>
