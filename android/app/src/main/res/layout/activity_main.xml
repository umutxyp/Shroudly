<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's Protection screen (components/ControlPanel.js), its
     counters (StatsPanel.js) and About (InfoPanel.js), in one column. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <me.codeshare.shroudly.Column
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- ── header ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_faint"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── the switch: halo, running arc, the circle with the logo ── -->
        <FrameLayout
            android:layout_width="224dp"
            android:layout_height="224dp"
            android:layout_marginTop="14dp"
            >

            <!-- 212dp in a 224dp frame: room to breathe (scale 1.04). -->
            <View
                android:id="@+id/halo"
                android:layout_width="212dp"
                android:layout_height="212dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/ring"
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_ring"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <FrameLayout
                android:id="@+id/toggle"
                android:layout_width="172dp"
                android:layout_height="172dp"
                android:layout_gravity="center"
                android:background="@drawable/orb"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press">

                <ImageView
                    android:id="@+id/toggleIcon"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <!-- What a tap on the switch does; the switch says it to TalkBack. -->
        <LinearLayout
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <ImageView
                android:importantForAccessibility="no"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_power"
                android:tint="?attr/accentLight" />

            <TextView
                android:id="@+id/hintLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/accentLight"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:minLines="2"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailMore"
            style="@style/Link"
            android:text="@string/androidDetails"
            android:visibility="gone" />

        <!-- Battery settings may stop protection in the background: shown
             while they do (Diagnostics.batteryHint). -->
        <LinearLayout
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:importantForAccessibility="no"
                style="@style/RowIcon"
                android:src="@drawable/ic_battery" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/androidBatteryHint"
                android:textAlignment="viewStart"
                android:textColor="@color/text_dim"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/batteryOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_accent"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="@string/androidBatterySettings"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- A newer version on GitHub (the APK from GitHub only). -->
        <LinearLayout
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:importantForAccessibility="no"
                style="@style/RowIcon"
                android:src="@drawable/ic_download" />

            <TextView
                android:id="@+id/updateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/updateOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_accent"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="@string/androidDownloadApk"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Supporting Shroudly, now and then while protection is on (the
             APK from GitHub only; Support.cardDue). -->
        <LinearLayout
            android:id="@+id/support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="6dp">

                <ImageView
                    android:importantForAccessibility="no"
                    style="@style/RowIcon"
                    android:src="@drawable/ic_heart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/supportBanner"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_dim"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/supportLater"
                    style="@style/Link"
                    android:layout_marginEnd="6dp"
                    android:text="@string/supportBannerLater"
                    android:textColor="@color/text_dim" />

                <Button
                    android:id="@+id/supportOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_accent"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="@string/supportBannerOpen"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── the counters ───────────────────────────────────────────── -->
        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="@string/navStats" />

        <LinearLayout
            android:id="@+id/statsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/banner"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="?attr/accentLight" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/statsInactiveHint"
                android:textAlignment="viewStart"
                android:textColor="@color/text_dim"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatTile">

                <LinearLayout style="@style/StatHead">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/StatIcon"
                        android:src="@drawable/ic_link" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/connections" />
                </LinearLayout>

                <TextView
                    android:id="@+id/connections"
                    style="@style/StatValue" />

                <TextView
                    android:id="@+id/connectionsTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatTile"
                android:layout_marginStart="12dp">

                <LinearLayout style="@style/StatHead">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/StatIcon"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/uptime" />
                </LinearLayout>

                <TextView
                    android:id="@+id/uptime"
                    style="@style/StatValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatTile">

                <LinearLayout style="@style/StatHead">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/StatIcon"
                        android:src="@drawable/ic_arrow_down" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/download" />
                </LinearLayout>

                <TextView
                    android:id="@+id/download"
                    style="@style/StatValue" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatTile"
                android:layout_marginStart="12dp">

                <LinearLayout style="@style/StatHead">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/StatIcon"
                        android:src="@drawable/ic_arrow_up" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="@string/upload" />
                </LinearLayout>

                <TextView
                    android:id="@+id/upload"
                    style="@style/StatValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── about ──────────────────────────────────────────────────── -->
        <TextView
            style="@style/SectionTitle"
            android:accessibilityHeading="true"
            android:text="@string/navInfo" />

        <LinearLayout
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="1dp">

            <!-- PayPal and bank transfer (Support; the APK from GitHub only). -->
            <LinearLayout
                android:id="@+id/supportRow"
                style="@style/AboutRow"
                android:visibility="gone">

                <ImageView
                    android:importantForAccessibility="no"
                    style="@style/RowIcon"
                    android:src="@drawable/ic_heart" />

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/supportTitle" />

                <ImageView
                    android:importantForAccessibility="no" style="@style/Chevron" />
            </LinearLayout>

            <View
                android:id="@+id/supportDivider"
                style="@style/Divider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/releases"
                style="@style/AboutRow">

                <ImageView
                    android:importantForAccessibility="no"
                    android:id="@+id/releasesIcon"
                    style="@style/RowIcon"
                    android:src="@drawable/ic_file_text" />

                <TextView
                    android:id="@+id/releasesLabel"
                    style="@style/RowLabel"
                    android:text="@string/linkReleases" />

                <ImageView
                    android:importantForAccessibility="no" style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/notices"
                style="@style/AboutRow">

                <ImageView
                    android:importantForAccessibility="no"
                    style="@style/RowIcon"
                    android:src="@drawable/ic_scale" />

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/openSourceTitle" />

                <ImageView
                    android:importantForAccessibility="no" style="@style/Chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/privacy"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_lock"
                android:text="@string/androidPrivacyPolicy" />

            <View style="@style/Divider" />

            <!-- The live count (OnlineCount), as the desktop's setting: its
                 label, and under it the description (MainActivity), are the
                 switch's own text, so TalkBack reads them as one control. -->
            <Switch
                android:id="@+id/shareOnlineCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:drawableStart="@drawable/row_users"
                android:drawablePadding="14dp"
                android:lineSpacingMultiplier="1.1"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:switchPadding="12dp"
                android:text="@string/shareOnlineCount"
                android:textAlignment="viewStart"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <View style="@style/Divider" />

            <!-- "Block ads and trackers" (AdBlock), off by default; as the
                 desktop's setting, label and description in the switch. -->
            <Switch
                android:id="@+id/adBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:drawableStart="@drawable/row_shield"
                android:drawablePadding="14dp"
                android:lineSpacingMultiplier="1.1"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:switchPadding="12dp"
                android:text="@string/adBlock"
                android:textAlignment="viewStart"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <!-- Its exceptions, shown while it is on. -->
            <TextView
                android:id="@+id/adBlockAllow"
                android:visibility="gone"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_link"
                android:text="@string/adBlockAllow" />

            <View style="@style/Divider" />

            <!-- The technique, the apps that skip Shroudly and starting with
                 the phone (SettingsActivity). -->
            <TextView
                android:id="@+id/settings"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_settings"
                android:text="@string/navSettings" />

            <View style="@style/Divider" />

            <!-- The recent log and the phone's details, to send to us. -->
            <TextView
                android:id="@+id/shareLogs"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_share"
                android:text="@string/androidShareLogs" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_faint"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/madeBy"
            android:textColor="@color/text_faint"
            android:textSize="12sp" />
    </me.codeshare.shroudly.Column>
</ScrollView>
