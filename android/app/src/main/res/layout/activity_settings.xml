<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (SettingsActivity): what the desktop's Settings has that a phone
     can use, in the main window's cards, under a bar with its title and a way
     back, as any Android screen has (issue #47). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<Toolbar
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/actionBarSize"
    android:background="@color/bg"
    android:navigationContentDescription="@string/androidBack"
    android:navigationIcon="@drawable/ic_arrow_back"
    android:title="@string/navSettings"
    android:titleTextColor="@color/text" />

<ScrollView
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <me.codeshare.shroudly.Column
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- VPN (every app) or proxy only (the VPN slot left free). -->
        <TextView
            android:id="@+id/modeTitle"
            style="@style/SectionTitle.Explained"
            android:accessibilityHeading="true"
            android:text="@string/androidModeTitle" />

        <RadioGroup
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp" />

        <!-- Appearance: the accent colour, as the desktop's. -->
        <TextView
            style="@style/SectionTitle"
            android:accessibilityHeading="true"
            android:text="@string/accentColour" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/accents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- The app's language: the phone's, or one chosen here (issue #38). -->
        <TextView
            style="@style/SectionTitle"
            android:accessibilityHeading="true"
            android:text="@string/language" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/language"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_languages"
                android:text="@string/languageSystem" />
        </LinearLayout>

        <!-- The technique, as the desktop's "Bypass strategy". -->
        <TextView
            android:id="@+id/strategyTitle"
            style="@style/SectionTitle.Explained"
            android:accessibilityHeading="true"
            android:text="@string/strategy" />

        <RadioGroup
            android:id="@+id/strategy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp" />

        <!-- The DNS server: automatic, or one of the user's own (issue #34). -->
        <TextView
            style="@style/SectionTitle"
            android:accessibilityHeading="true"
            android:text="@string/dnsServer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:id="@+id/dnsServer"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_lock"
                android:text="@string/dnsServer" />
        </LinearLayout>

        <TextView
            android:id="@+id/appsTitle"
            style="@style/SectionTitle.Explained"
            android:accessibilityHeading="true"
            android:text="@string/androidAppsSection" />

        <LinearLayout
            android:id="@+id/appsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="1dp">

            <!-- Apps that skip Shroudly: the label, and how many under it. -->
            <TextView
                android:id="@+id/excludedApps"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_link"
                android:text="@string/excludedApps" />

            <View style="@style/Divider" />

            <!-- The Quick Settings tile: added from here (Android 13 and
                 later ask the user), or how to add it by hand before. -->
            <TextView
                android:id="@+id/quickTile"
                style="@style/AboutRowText"
                android:drawableStart="@drawable/row_shield"
                android:text="@string/androidTileAdd" />

            <View
                android:id="@+id/quickTileDivider"
                style="@style/Divider" />

            <Switch
                android:id="@+id/startAtBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:drawableStart="@drawable/row_shield"
                android:drawablePadding="14dp"
                android:lineSpacingMultiplier="1.1"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:switchPadding="12dp"
                android:text="@string/androidStartAtBoot"
                android:textAlignment="viewStart"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <View style="@style/Divider" />

            <!-- Automation apps (Tasker, MacroDroid): AutomationReceiver. -->
            <Switch
                android:id="@+id/remoteControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:drawableStart="@drawable/row_link"
                android:drawablePadding="14dp"
                android:lineSpacingMultiplier="1.1"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:switchPadding="12dp"
                android:text="@string/androidRemoteControl"
                android:textAlignment="viewStart"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </me.codeshare.shroudly.Column>
</ScrollView>
</LinearLayout>
