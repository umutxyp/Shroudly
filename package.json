{
  "name": "shroudly",
  "version": "2.0.4",
  "description": "Shroudly - Unseen. Unstoppable. | Cross-platform DPI bypass (self-contained engine)",
  "main": "electron/main.js",
  "private": true,
  "author": {
    "name": "Codeshare Technology Ltd",
    "email": "support@codeshare.me"
  },
  "homepage": "https://codeshare.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/umutxyp/Shroudly"
  },
  "bugs": {
    "url": "https://github.com/umutxyp/Shroudly/issues"
  },
  "license": "MIT",
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "next dev",
    "build": "next build && node scripts/fix-paths.js",
    "build:core": "node scripts/build-core.js",
    "build:core:all": "node scripts/build-core.js --cross",
    "postinstall": "node scripts/build-core.js || echo \"[core] skipped (no compiler); run npm run build:core later\"",
    "test:core": "cd core && make test",
    "create-icon": "node scripts/create-icon.js",
    "check:translations": "node scripts/check-translations.js",
    "verify": "npm run build:core && npm run check:translations && npm run build",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:prod": "npm run verify && electron .",
    "dist:win": "npm run verify && electron-builder --win nsis --publish never",
    "dist:mac": "npm run verify && electron-builder --mac --publish never",
    "dist:linux": "npm run verify && electron-builder --linux AppImage deb --publish never",
    "dist:all": "npm run build:core:all && npm run build:core:advanced:all && npm run fetch:windivert && npm run check:translations && npm run build && electron-builder -mwl --publish never",
    "build:core:advanced": "node scripts/build-core-advanced.js",
    "build:core:advanced:all": "node scripts/build-core-advanced.js --cross",
    "fetch:windivert": "node scripts/fetch-windivert.js",
    "publish:release": "node scripts/publish-release.js"
  },
  "build": {
    "appId": "me.codeshare.shroudly",
    "productName": "Shroudly",
    "copyright": "Copyright © 2026 Codeshare Technology Ltd",
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "!electron/tools/core/**",
      "package.json",
      "!**/*.map",
      "!**/*.pdb",
      "!core/**",
      "!**/README*",
      "!**/CHANGELOG*",
      "!**/*.test.*"
    ],
    "asarUnpack": [
      "electron/tools/core/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "public/icon.ico",
      "artifactName": "${productName}-${version}-Windows-${arch}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "files": [
        "electron/tools/core/win32-${arch}/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "include": "scripts/installer.nsh",
      "differentialPackage": false
    },
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/icon-small.png",
        "to": "icon-small.png"
      },
      {
        "from": "public",
        "to": ".",
        "filter": [
          "tray*Template*.png"
        ]
      }
    ],
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "files": [
        "electron/tools/core/darwin-${arch}/**"
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Codeshare Technology Ltd <support@codeshare.me>",
      "files": [
        "electron/tools/core/linux-${arch}/**"
      ],
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    },
    "deb": {
      "recommends": [
        "libnetfilter-queue1"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "umutxyp",
        "repo": "Shroudly",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "^33.3.1",
    "electron-builder": "^24.13.3",
    "next": "^14.2.35",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resedit": "3.0.2",
    "tailwindcss": "^3.4.0",
    "wait-on": "^7.2.0"
  }
}
