<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Apple TV build, signed by hand: automatic signing needs a registered
     Apple TV for its development profile, and the team has none. The
     distribution certificate and the two tvOS App Store profiles come from
     the APPLE_DIST_* secrets (.github/workflows/release.yml, job apple). -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>5W8MUW2F4V</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>me.codeshare.shroudly</key>
		<string>Shroudly tvOS App Store app</string>
		<key>me.codeshare.shroudly.tunnel</key>
		<string>Shroudly tvOS App Store tunnel</string>
	</dict>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
